# Copy to apps/server/.env. Credentials stay on the server; never use VITE_.
PORT=3001
HOST=127.0.0.1
OPENAI_API_KEY=
# Saving a key does NOT enable spending. Local paid mode requires bun run dev:live.
# Shared across live profiles/tabs; integer 1-10. Resets on server restart.
LIVE_MAX_ATTEMPTS=3
# Legacy AI_API_KEY is accepted when OPENAI_API_KEY is unset or blank.
# These settings control the lab's Server-configured models profile.
DESIGN_MODEL=gpt-5.6-sol
# none is supported for Sol/Terra/Luna; Astra requires low or higher.
DESIGN_REASONING=low
DESIGN_MAX_OUTPUT_TOKENS=2048
GEOMETRY_MODEL=gpt-6-astra
GEOMETRY_REASONING=low
GEOMETRY_MAX_OUTPUT_TOKENS=12000

# Speech transcription for explicitly enabled live attempts (English first).
TRANSCRIPTION_MODEL=gpt-transcribe

# Hosted deployment only. Previews always stay mock-only.
# Set these directly in Vercel; provider/Redis tokens must use the Secret type.
HOSTED_LIVE_ENABLED=false
APP_ORIGIN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Hosted allowance is initialized to 100 in Redis, not LIVE_MAX_ATTEMPTS.
# See docs/deployment.md for the one-time setup and manual reset commands.
