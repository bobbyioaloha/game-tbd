# Copy to apps/server/.env. Credentials stay on the server; never use VITE_.
PORT=3001
HOST=127.0.0.1
OPENAI_API_KEY=
# Saving a key does NOT enable spending. Only bun run dev:live opts in.
# Shared across live profiles/tabs; integer 1-10. Resets on server restart.
LIVE_MAX_ATTEMPTS=3
# Legacy AI_API_KEY is accepted when OPENAI_API_KEY is unset or blank.
# These settings control the lab's Server-configured models profile.
DESIGN_MODEL=gpt-5.6-sol
DESIGN_REASONING=low
DESIGN_MAX_OUTPUT_TOKENS=2048
GEOMETRY_MODEL=gpt-6-astra
GEOMETRY_REASONING=low
GEOMETRY_MAX_OUTPUT_TOKENS=12000
