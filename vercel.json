{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && bunx bun@1.4.2 install --frozen-lockfile",
      "buildCommand": "cd ../.. && bunx bun@1.4.2 run build:deploy:web",
      "outputDirectory": "dist"
    },
    "api": {
      "root": "apps/server",
      "framework": "fastify",
      "entrypoint": "src/vercel.ts",
      "outputDirectory": ".",
      "installCommand": "cd ../.. && bunx bun@1.4.2 install --frozen-lockfile",
      "buildCommand": "cd ../.. && bunx bun@1.4.2 run build:deploy:server",
      "functions": {
        "src/vercel.ts": {
          "maxDuration": 60,
          "supportsCancellation": true
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
