{
  "name": "@sky/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev:live": "tsx --env-file-if-exists=.env src/index.ts --live"
  },
  "dependencies": {
    "@sky/shared": "0.1.0",
    "fastify": "^5.6.0",
    "openai": "^7.15.0",
    "@fastify/multipart": "^9.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
